DEBUG=true
SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_URL=http://localhost:8000
# SQLite is available for zero-setup local development. Set PostgreSQL for deployment.
DATABASE_URL=sqlite:///hirelens.sqlite3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
# The live interviewer uses a short-lived, constrained browser token. Keep this server-side.
GEMINI_LIVE_MODEL=gemini-3.8-live
AI_LIVE_SESSIONS_PER_MINUTE=3
AI_LIVE_SESSIONS_PER_DAY=30
# Project-specific caps: set these below the limits shown in Google AI Studio.
AI_REQUESTS_PER_MINUTE=8
AI_REQUESTS_PER_DAY=100
# Free API mode accepts only explicitly acknowledged non-sensitive demo interviews.
AI_DATA_POLICY=demo_only
RESEND_API_KEY=
EMAIL_FROM=HireLens <onboarding@resend.dev>
SESSION_COOKIE_SECURE=false
